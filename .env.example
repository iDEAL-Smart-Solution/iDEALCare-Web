# Backend API base URL.
# Copy this file to .env.local and fill in values for your environment.
# Do NOT commit .env.local — it is covered by *.local in .gitignore.
VITE_API_BASE_URL=http://localhost:5000

# Optional local tenant hostname override. Used only while running Vite in dev.
VITE_DEV_TENANT_DOMAIN=localhost

# Set to true to bypass authentication during development.
# Mock user/tenant data lives in src/data/mockAuth.ts.
# Set to false (or remove) when the backend is ready.
VITE_DEV_BYPASS_AUTH=false
